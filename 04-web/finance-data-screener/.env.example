# PostgreSQL
POSTGRES_USER=screener
POSTGRES_PASSWORD=screener_pass
POSTGRES_DB=screener_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ProxyAPI (gpt-4o-mini через proxyapi.ru)
PROXYAPI_KEY=your_proxyapi_key_here
PROXYAPI_BASE_URL=https://api.proxyapi.ru/openai/v1

# Backend
BACKEND_PORT=8000
DEBUG=false

# Frontend
VITE_API_URL=http://localhost:8000

# Docker Compose project name (required — prevents naming issues with Cyrillic paths)
COMPOSE_PROJECT_NAME=screener

# SSL verification for external API requests (MOEX, ЦБ РФ, ТАСС)
# Set to false if running behind a corporate proxy/antivirus that intercepts SSL
# Default: true (recommended for production)
SSL_VERIFY=true
