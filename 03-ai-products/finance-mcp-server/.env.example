# Finance MCP Server — корневые настройки
# Скопируйте этот файл в .env и заполните нужные значения

# -----------------------------------------------------------------------
# MCP-сервер (product-mcp)
# -----------------------------------------------------------------------

# Путь к SQLite-базе (по умолчанию: product-mcp/data/product_mcp.db)
PRODUCT_MCP_DB_PATH=

# Уровень логирования: DEBUG, INFO, WARNING, ERROR
PRODUCT_MCP_LOG_LEVEL=INFO
