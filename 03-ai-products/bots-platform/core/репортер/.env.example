# Путь к папке Money_alert_AI/src (обязательно!)
# Fallback: автоопределение ../../../Money_alert_AI/src относительно этого файла
MONEY_ALERT_SRC=C:\_Рабочая_папка\Проекты_программирование\Money_alert_AI\src

# Провайдер LLM: gigachat, openai, gemini или anthropic
MODEL_PROVIDER=openai

# GigaChat (при MODEL_PROVIDER=gigachat)
# GIGACHAT_USER=your_username
# GIGACHAT_PASSWORD=your_password
# GIGACHAT_BASE_URL=https://gigachat.devices.sberbank.ru/api/v1
# GIGACHAT_VERIFY_SSL_CERTS=False
# GIGACHAT_MODEL=GigaChat-2-Max

# OpenAI (при MODEL_PROVIDER=openai)
# OPENAI_API_KEY=sk-xxxxx
# OPENAI_MODEL=gpt-5.2

# Gemini (при MODEL_PROVIDER=gemini)
# GOOGLE_API_KEY=AIza...
# GEMINI_MODEL=gemini-3.1-pro-preview

# Anthropic (при MODEL_PROVIDER=anthropic)
# ANTHROPIC_API_KEY=sk-ant-xxxxx
# ANTHROPIC_MODEL=claude-opus-4-6

# Tavily (поиск)
TAVILY_API_KEY=tvly-xxxxx

# Telegram
TELEGRAM_BOT_TOKEN=your_bot_token
TELEGRAM_CHANNEL_ID=-1001324653248
TELEGRAM_ADMIN_CHAT_ID=316087324

# Опционально
# CRITERIA_FILE=criteria.json
# DISABLE_TELEGRAM=0
