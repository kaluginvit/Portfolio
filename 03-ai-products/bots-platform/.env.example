# Каждый бот запускается независимо из core/<бот>/
# Скопируй нужный блок в core/<бот>/.env

# --- Общее (все боты) ---
TELEGRAM_BOT_TOKEN=your_bot_token

# --- модератор ---
WHITELIST_USER_IDS=123456789,987654321

# --- репортер ---
TELEGRAM_CHANNEL_ID=-100xxxxxxxxxx
TELEGRAM_CHANNEL_USERNAME=your_channel_username
TELEGRAM_ADMIN_CHAT_ID=xxxxxxxxx
TG_API_ID=your_telegram_api_id
TG_API_HASH=your_telegram_api_hash
MONEY_ALERT_SRC=/path/to/rf-macro-risk-ai/src

# --- сторож ---
TELEGRAM_GROUP_ID=-100xxxxxxxxxx
EXPORT_WEB_JSON=/path/to/export.json
SITE_URL=https://your-site.com
WATCH_INTERVAL=60
